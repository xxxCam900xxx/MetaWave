FROM python:3.12-slim

RUN apt-get update && apt-get install -y ffmpeg
RUN apt-get install -y nodejs npm

WORKDIR /app

COPY app/metawave_server/downloader/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Alle Downloader-Skripte ins Image kopieren
COPY app/metawave_server/downloader/*.py .

# Optionale Cookie-Datei für authentifizierte YouTube-Requests.
COPY app/metawave_server/downloader/www.youtube.com_cookies.txt /cookies/www.youtube.com_cookies.txt
ENV YT_COOKIES=/cookies/www.youtube.com_cookies.txt

# Datenbankverbindung (Werte werden via env_file aus .env gesetzt)
ENV DB_HOST=database
ENV DB_PORT=3306
ENV DB_NAME=database_metawave
ENV DB_USER=metawave_user
ENV DB_PASS=

VOLUME ["/songs"]

ENV PYTHONUNBUFFERED=1
CMD ["python", "-u", "sync_playlist.py"]