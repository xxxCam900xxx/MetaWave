{
  "expo": {
    "name": "MetaWave",
    "slug": "MetaWaveApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/web/icon-512.png",
    "scheme": "metawaveapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1C",
        "foregroundImage": "./assets/icons/android/android_launcher_foreground.png",
        "monochromeImage": "./assets/icons/android/android_launcher_monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/web/favicon.ico",
      "bundler": "metro",
      "name": "MetaWave",
      "shortName": "MetaWave",
      "description": "Dein persönlicher Live Radio Stream",
      "themeColor": "#6A55B7",
      "backgroundColor": "#1C1C1C",
      "lang": "de"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/web/icon-512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1C",
          "dark": {
            "backgroundColor": "#1C1C1C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
